MONGODB_URI=mongodb://localhost:27017/culture-quest
JWT_SECRET=change-me-in-real-env
JWT_EXPIRES_IN=7d
PORT=3000
ADMIN_EMAIL=admin@culturequest.local
ADMIN_PASSWORD=change-this-local-admin-password
# Where uploaded files (e.g. the site logo) are written on disk. Defaults to ./uploads; point it at a
# persistent, writable path (Docker already mounts a volume there - see docker-compose.prod.yml).
UPLOAD_DIR=./uploads
