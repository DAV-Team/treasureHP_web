JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@culturequest.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
WEB_PORT=8080
# Google Maps JavaScript API key (public in the built bundle - restrict it by HTTP referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Set to 127.0.0.1 when a host reverse proxy (nginx + HTTPS) sits in front of the app.
WEB_HOST=0.0.0.0
